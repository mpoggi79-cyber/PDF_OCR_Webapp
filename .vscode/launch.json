{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug FastAPI backend",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8080",
        "--reload",
        "--reload-exclude",
        ".venv",
        "--reload-exclude",
        "uploads",
        "--reload-exclude",
        "tests"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
    }
  ]
}